# ── Telegram credentials (https://my.telegram.org/apps) ───────────────────────
API_ID=
API_HASH=
TOKEN=

# ── Bot behaviour ─────────────────────────────────────────────────────────────
OWNER_ID=0                 # your numeric Telegram user id (sudo owner)
DEFAULT_LANG=en            # en | hi | ar | tr
PORT=8000                  # health endpoint, 0 disables
SET_CMDS=true              # publish the command menu
DISABLE_COLOUR=false       # true = plain buttons instead of coloured ones
BOT_BRAND=                 # display name used for {bot} (defaults to Nandani Music)
REPO_URL=                  # shown as the repo button (empty = hidden)

# ── Transport ─────────────────────────────────────────────────────────────────
# Raw MTProto 2.0 (TCP intermediate) — the bot talks to Telegram directly,
# no Bot HTTP API involved.
DC=2                           # data centre used for the first connection
BOT_SESSION=data/bot.session   # auth key cached here; delete it to re-authorise

# ── Assistant (userbot) accounts ─────────────────────────────────────────────
# A bot account cannot join a group call: add user accounts ("assistants").
# Pyrogram-format session strings (271-byte type), comma separated.
STRING_SESSIONS=
NTGCALLS_LIB=/usr/local/lib/libntgcalls.so
TDJSON_LIB=/usr/local/lib/libtdjson.so
TDLIB_ASSISTANT_DIR=data/tdlib/assistant

# ── Music providers ──────────────────────────────────────────────────────────
# Yuki API: audio search + mp3 stream gateway (audio only — video needs yt-dlp)
YUKI_API_URL=https://music.yukiapi.site
YUKI_API_KEY=

# ── yt-dlp extraction ────────────────────────────────────────────────────────
# YouTube bot-checks datacentre IPs. For /vplay (video) set either:
#   COOKIES_LINK=/path/to/cookies.txt   (or drop the file at data/cookies.txt)
#   YTDLP_PROXY=http://host:port
COOKIES_LINK=
YTDLP_PROXY=

# ── Iota API (self-hosted search/stream tier) ─────────────────────────────────
# https://github.com/Iotatg/Iota-api — YouTube provider needs the same cookies
IOTA_API_URL=
IOTA_API_KEY=

# ── AI chatbot ──
# Any OpenAI-compatible endpoint. The first configured set wins.
# APINEX_API_KEY=
# APINEX_API_URL=https://api.apinex.bond/v1
# APINEX_MODEL=free/gemini-3.8-flash
# APINEX_FALLBACK_MODEL=free/gpt-6-luna
CHATBOT_ENABLED=true
# Log why a group message was ignored (useful when a bot seems deaf).
# CHATBOT_DEBUG=1
# Provider quota: calls per minute for the account (apinex free = 5).
# CHATBOT_RPM=5
# Her identity — baked into the persona, overridable without touching code.
BOT_AGE=22
BOT_FROM=Lucknow
BOT_DOB=3 September
OWNER_NAME=ɴᴏᴛʜɪɴɢ
OWNER_USERNAME=im_ntg
